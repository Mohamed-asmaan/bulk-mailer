# Copy this file to .env in the same folder and fill in your value.
# Do not commit .env.
#
# Railway: add a Variable on the same service that runs this app (not only “project” scope if unused).
# The server accepts the first non-empty value among:
#   MONGODB_URI | DATABASE_URL | MONGO_URL | MONGODB_URL
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/DATABASE?appName=Cluster0
#
# Mail: this app does NOT read EMAIL_USER / EMAIL_PASS from env. It loads Gmail SMTP from MongoDB:
#   collection name: bulkmail  — one document with string fields: user (Gmail address), pass
# For Google accounts, `pass` must be a Google "App password" (2FA on). Normal passwords are rejected.
