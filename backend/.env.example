# Copy this file to .env in the same folder and fill in your value.
# Do not commit .env.
#
# Hosting (Render / etc): add as Environment variables on the service that runs this app.
# The server accepts the first non-empty value among:
#   MONGODB_URI | DATABASE_URL | MONGO_URL | MONGODB_URL
# Include the database name in the path (before ?). Example for DB "passkey":
# MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/passkey?appName=Cluster0
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/passkey?appName=Cluster0
#
# Mail: this app does NOT read EMAIL_USER / EMAIL_PASS from env. It loads Gmail SMTP from MongoDB:
#   collection name: bulkmail  — one document with string fields: user (Gmail address), pass
# For Google accounts, `pass` must be a Google "App password" (2FA on). Normal passwords are rejected.
#
# Database name: usually the path in MONGODB_URI (e.g. ...mongodb.net/passkey?...).
# If creds live in a different DB than the URI path, set:
# MONGO_DB_NAME=passkey

# Optional — comma-separated extra allowed CORS origins (e.g. Vercel preview URLs):
# FRONTEND_ORIGINS=https://your-branch.vercel.app

# Rate limit POST /sendmail (defaults: 30 requests / 15 min / IP behind trust proxy):
# SENDMAIL_RATE_MAX=30
# SENDMAIL_RATE_WINDOW_MS=900000

# Large campaigns / slow SMTP tuning:
# MAX_RECIPIENTS=500
# MAX_MESSAGE_CHARS=100000
# SMTP_PER_MESSAGE_TIMEOUT_MS=90000
# SMTP_SEND_GAP_MS=200

# SMTP transport overrides (defaults assume Gmail on 465/TLS).
# If your host blocks/flaps on port 465 (some PaaS free tiers do), switch to 587 STARTTLS:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_SECURE=false        # auto-derived from PORT when unset (465 → true, else false)
# Connection/greeting/socket timeouts (ms) — bumped if SMTP cold-starts are slow:
# SMTP_CONNECTION_TIMEOUT_MS=30000
# SMTP_GREETING_TIMEOUT_MS=30000
# SMTP_SOCKET_TIMEOUT_MS=60000

# Bearer-style secret — only if you want SMTP verify inside GET /health/diagnostics:
# Set the same value in header `x-health-diagnostics-token` on that request only.
# HEALTH_DIAGNOSTICS_TOKEN=

# Behind reverse proxy hops (trust proxy depth — Render/Vercel/etc):
# TRUST_PROXY_HOPS=1
