# Local dev: copy to `.env` and use your backend (no trailing slash).
# VITE_API_URL=http://localhost:5000
#
# Optional — axios timeout ms for POST /sendmail (large batches / slow SMTP). Default in code: 180000.
# VITE_API_TIMEOUT_MS=180000
#
# Production: see `.env.production` — Railway API baked into builds:
#   https://bulk-mailer-production-c860.up.railway.app
# To override on Vercel → Environment Variables → VITE_API_URL
